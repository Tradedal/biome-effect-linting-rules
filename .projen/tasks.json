{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(yarn exec node --print process.env.PATH)"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --no-merges --oneline $LATEST_TAG..HEAD -E --grep '^(feat|fix){1}(\\([^()[:space:]]+\\))?(!)?:[[:blank:]]+.+'"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)",
        "HEAD_COMMIT": "$(git rev-parse --short HEAD)"
      },
      "steps": [
        {
          "exec": "git checkout -B \"scratch-$HEAD_COMMIT\"",
          "name": "save current HEAD in a \"scratch-<commit>\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under a \"scratch-<commit>\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "effect-language-service patch"
        },
        {
          "exec": "tsc --project tsconfig.build.json"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "tsx .projenrc.ts"
        }
      ]
    },
    "effect:diagnostics": {
      "name": "effect:diagnostics",
      "steps": [
        {
          "exec": "effect-language-service diagnostics --project tsconfig.json",
          "receiveArgs": true
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "format": {
      "name": "format",
      "steps": [
        {
          "exec": "biome format --config-path=biome.base.jsonc --write .projenrc.ts bin scripts src rules configs examples tests vitest.config.mts"
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "yarn install --no-immutable"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "yarn install --immutable"
        }
      ]
    },
    "lint": {
      "name": "lint",
      "steps": [
        {
          "exec": "biome check",
          "receiveArgs": true
        }
      ]
    },
    "lint:dev": {
      "name": "lint:dev",
      "steps": [
        {
          "exec": "biome check --config-path=biome.jsonc",
          "receiveArgs": true
        }
      ]
    },
    "lint:local": {
      "name": "lint:local",
      "steps": [
        {
          "exec": "biome check --config-path=biome.local.jsonc",
          "receiveArgs": true
        }
      ]
    },
    "pack:dry-run": {
      "name": "pack:dry-run",
      "steps": [
        {
          "spawn": "compile"
        },
        {
          "exec": "npm pack --dry-run"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "refresh:biome-grammars": {
      "name": "refresh:biome-grammars",
      "steps": [
        {
          "exec": "tsx scripts/refresh-biome-grammars.ts"
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"master\" branch",
      "env": {
        "RELEASE": "true",
        "MAJOR": "0"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "yarn lint"
        },
        {
          "spawn": "compile"
        },
        {
          "exec": "vitest run"
        },
        {
          "exec": "yarn typecheck"
        }
      ]
    },
    "test:update": {
      "name": "test:update",
      "steps": [
        {
          "spawn": "format"
        },
        {
          "exec": "yarn lint"
        },
        {
          "spawn": "compile"
        },
        {
          "exec": "vitest run --update"
        },
        {
          "exec": "yarn typecheck"
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "steps": [
        {
          "exec": "effect-language-service patch"
        },
        {
          "exec": "tsc --project tsconfig.json"
        },
        {
          "spawn": "typecheck:fixtures"
        }
      ]
    },
    "typecheck:fixtures": {
      "name": "typecheck:fixtures",
      "steps": [
        {
          "exec": "tsc --project tsconfig.fixtures.json"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0",
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      },
      "steps": [
        {
          "exec": "yarn install --no-immutable"
        },
        {
          "execArgs": [
            "yarn",
            "up",
            "-R",
            "@biomejs/biome",
            "@effect/atom-react",
            "@effect/language-service",
            "@tradedal/linteffect",
            "@types/node",
            "@types/react",
            "@vanilla-extract/css",
            "commit-and-tag-version",
            "constructs",
            "projen",
            "react",
            "scheduler",
            "tsx",
            "typescript",
            "vite",
            "vitest",
            "@biomejs/wasm-nodejs",
            "@effect/platform-node-shared",
            "effect"
          ]
        },
        {
          "exec": "yarn projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"yarn projen\"."
}
