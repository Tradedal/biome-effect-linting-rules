{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "plugins": [
    "./node_modules/@tradedal/linteffect/rules/no-effect-type-alias.grit",
    "./node_modules/@tradedal/linteffect/rules/no-model-overlay-cast.grit",
    "./node_modules/@tradedal/linteffect/rules/no-manual-data-guard.grit",
    "./node_modules/@tradedal/linteffect/rules/no-unknown-boolean-coercion-helper.grit",
    "./node_modules/@tradedal/linteffect/rules/no-fromnullable-nullish-coalesce.grit",
    "./node_modules/@tradedal/linteffect/rules/no-option-boolean-normalization.grit",
    "./node_modules/@tradedal/linteffect/rules/no-string-sentinel-return.grit",
    "./node_modules/@tradedal/linteffect/rules/no-string-sentinel-const.grit"
  ]
}
