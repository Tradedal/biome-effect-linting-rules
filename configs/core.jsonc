{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "plugins": [
    "./node_modules/@tradedal/linteffect/rules/no-layer-this-reference.grit",
    "./node_modules/@tradedal/linteffect/rules/no-if-statement.grit",
    "./node_modules/@tradedal/linteffect/rules/no-switch-statement.grit",
    "./node_modules/@tradedal/linteffect/rules/no-ternary.grit",
    "./node_modules/@tradedal/linteffect/rules/no-loop-statement.grit",
    "./node_modules/@tradedal/linteffect/rules/no-mutable-state.grit",
    "./node_modules/@tradedal/linteffect/rules/no-throw-statement.grit",
    "./node_modules/@tradedal/linteffect/rules/no-return-null.grit",
    "./node_modules/@tradedal/linteffect/rules/no-flatmap-ladder.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-ladder.grit",
    "./node_modules/@tradedal/linteffect/rules/no-nested-effect-call.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-as.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-wrapper-alias.grit",
    "./node_modules/@tradedal/linteffect/rules/no-call-tower.grit",
    "./node_modules/@tradedal/linteffect/rules/no-option-as.grit",
    "./node_modules/@tradedal/linteffect/rules/no-arrow-ladder.grit",
    "./node_modules/@tradedal/linteffect/rules/no-branch-in-object.grit",
    "./node_modules/@tradedal/linteffect/rules/no-iife-wrapper.grit",
    "./node_modules/@tradedal/linteffect/rules/no-return-in-arrow.grit",
    "./node_modules/@tradedal/linteffect/rules/warn-native-collections.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-bind.grit",
    "./node_modules/@tradedal/linteffect/rules/no-nested-effect-gen.grit",
    "./node_modules/@tradedal/linteffect/rules/no-runtime-runfork.grit",
    "./node_modules/@tradedal/linteffect/rules/no-match-void-branch.grit",
    "./node_modules/@tradedal/linteffect/rules/no-match-effect-branch.grit",
    "./node_modules/@tradedal/linteffect/rules/warn-effect-sync-wrapper.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-side-effect-wrapper.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-all-step-sequencing.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-step-const-staging.grit",
    "./node_modules/@tradedal/linteffect/rules/no-fragmented-const-assembly.grit",
    "./node_modules/@tradedal/linteffect/rules/no-pipeline-fragment-staging.grit",
    "./node_modules/@tradedal/linteffect/rules/no-manual-data-guard.grit",
    "./node_modules/@tradedal/linteffect/rules/no-effect-orElse-ladder.grit",
    "./node_modules/@tradedal/linteffect/rules/no-return-in-callback.grit",
    "./node_modules/@tradedal/linteffect/rules/no-try-catch.grit",
    "./node_modules/@tradedal/linteffect/rules/no-manual-effect-channels.grit",
    "./node_modules/@tradedal/linteffect/rules/prevent-dynamic-imports.grit"
  ]
}
